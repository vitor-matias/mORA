{
  "name": "mora-palavra-publisher",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Publishes mORA's Palavra Bíblica do Dia to Nostr, once a day. No server.",
  "scripts": {
    "start": "node publish.js --watch",
    "keygen": "node keygen.js",
    "verify": "node verify.js",
    "publish-today": "node publish.js",
    "backfill": "node publish.js --backfill 7",
    "badges": "node --experimental-strip-types badges.js",
    "badges-dry-run": "node --experimental-strip-types badges.js --dry-run"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "nostr-tools": "^2.23.9",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
