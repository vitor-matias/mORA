# Copy to `.env.development.local` for local overrides, NOT to `.env`.
#
# Vite loads a plain `.env` in production builds too, so a dev value left
# there ships in the bundle — `npm run build` with a local relay in `.env`
# produces a deployable that points at ws://localhost. `.env.development.local`
# is only read by `vite dev`.
#
# In production these are set where the app is BUILT (Vite inlines them at
# build time; there is no runtime config). For GitHub Pages that means
# repository variables — see .github/workflows/deploy.yml.

# Web Push reminders — leave unset to keep the in-app-only fallback.
# Setup: see workers/push/README.md
VITE_PUSH_SERVER_URL=
VITE_VAPID_PUBLIC_KEY=

# Palavra Bíblica do Dia — the pubkey that publishes the daily puzzle to Nostr.
# Anyone can publish an event claiming to be today's puzzle; pinning this key
# is what lets the app tell the real one apart. Leave unset to play against the
# built-in mock (fifteen verses, badged as demo in the UI).
# Setup: see server/palavra/README.md
VITE_PALAVRA_PUBLISHER_PUBKEY=

# Relays to read and write on. Comma-separated; overrides the built-in set.
# Mainly for pointing at a local relay while developing.
VITE_NOSTR_RELAYS=
